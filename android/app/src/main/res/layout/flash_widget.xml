<?xml version="1.0" encoding="utf-8"?>
<!-- Widget vuông bo góc: header + một thẻ flashcard (hai mặt chồng nhau, chạm để lật)
     + thanh dưới ‹ vị trí ›. RemoteViews thường, không dùng danh sách. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="2dp"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <!-- Header: chạm để mở app vào chủ đề của thẻ đang hiện -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:paddingBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Flash English"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#FF4F46E5"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:textSize="11sp"
            android:textColor="#FF6B7280"
            android:maxLines="1" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Mặt trước: từ + "Chạm để lật" -->
        <LinearLayout
            android:id="@+id/card_front"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/widget_card_front">
            <TextView
                android:id="@+id/front_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FF111827"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/front_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="#FF9CA3AF"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Mặt sau: từ, loại từ, phiên âm, nghĩa -->
        <LinearLayout
            android:id="@+id/card_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/widget_card_back"
            android:visibility="gone">
            <TextView
                android:id="@+id/back_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF111827"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/back_pos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="#FF4F46E5"
                android:maxLines="1" />
            <TextView
                android:id="@+id/back_pronunciation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#FF6B7280"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/back_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="#FF111827"
                android:maxLines="3"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Trạng thái rỗng / widget tắt: chạm để mở app hoặc màn cấu hình -->
        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:textSize="13sp"
            android:textColor="#FF6B7280"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Thanh dưới: ‹  3/10  › (mỗi nút vùng chạm tối thiểu 40dp) -->
    <LinearLayout
        android:id="@+id/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="#FF4F46E5"
            android:contentDescription="Previous" />
        <TextView
            android:id="@+id/widget_pos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#FF6B7280"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="›"
            android:textSize="24sp"
            android:textColor="#FF4F46E5"
            android:contentDescription="Next" />
    </LinearLayout>
</LinearLayout>
