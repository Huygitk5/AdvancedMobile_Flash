<?xml version="1.0" encoding="utf-8"?>
<!-- Mặt sau: từ, loại từ, phiên âm, nghĩa (giống mặt sau flashcard trong app). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_card_back">

    <TextView
        android:id="@+id/card_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF111827"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/card_pos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="#FF4F46E5"
        android:maxLines="1" />
    <TextView
        android:id="@+id/card_pronunciation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#FF6B7280"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/card_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="15sp"
        android:textColor="#FF111827"
        android:maxLines="3"
        android:ellipsize="end" />
</LinearLayout>
