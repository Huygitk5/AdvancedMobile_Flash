<?xml version="1.0" encoding="utf-8"?>
<!-- Mặt trước: chỉ có từ + gợi ý "Chạm để lật". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_card_front">

    <TextView
        android:id="@+id/card_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FF111827"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/card_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="#FF9CA3AF"
        android:maxLines="1" />
</LinearLayout>
