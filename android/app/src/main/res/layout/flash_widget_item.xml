<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng của danh sách: từ, phiên âm, nghĩa, đường kẻ phân cách. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/item_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FF111827"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/item_pronunciation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#FF6B7280"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/item_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#FF111827"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- RemoteViews không cho dùng View thường → dùng ImageView có nền làm đường kẻ. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#FFE5E7EB"
        android:importantForAccessibility="no" />
</LinearLayout>
